# Copy this file to .env.local and fill in your Paystack keys.
# Test keys: https://dashboard.paystack.com/#/settings/developers
# Currency is Ghana Cedis (GHS). Paystack checkout offers Mobile Money + Visa/Mastercard.

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL Paystack returns the donor to after payment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — emails the foundation on each confirmed donation (Paystack webhook).
# API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DONATION_NOTIFY_EMAIL=annfamfoundation@gmail.com
# For production, verify a domain in Resend and use an address on it (e.g. donations@yourdomain.org).
DONATION_FROM_EMAIL=onboarding@resend.dev
